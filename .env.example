# Копируется в .env. Все значения имеют рабочие значения по умолчанию.

# --- Сервер ---
TASKFLOW_HOST=0.0.0.0
TASKFLOW_PORT=8080
TASKFLOW_DEBUG=false
TASKFLOW_ROOT_LEVEL=INFO

# --- База данных ---
# SQLite по умолчанию. Поддерживаются также:
#   postgresql+asyncpg://user:pass@host:5432/db
#   mysql+aiomysql://user:pass@host:3306/db
DATABASE_URL=sqlite+aiosqlite:///./data/taskflow.db
DB_ECHO=false

# --- Безопасность ---
# Оставьте пустым — сервер сгенерирует секрет при первом запуске и сохранит
# в data/secret.key. Укажите вручную, чтобы ключ был под контролем.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Политика паролей
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=10
LOCKOUT_MINUTES=15

# --- CORS ---
# Список разрешённых источников через запятую. Пусто = зеркала текущего origin.
CORS_ORIGINS=

# --- Загрузка файлов ---
MAX_UPLOAD_MB=25
STORAGE_DIR=./data/storage
PREVIEW_MAX_EDGE=1280

# --- Распознавание голоса ---
# base — быстрый старт, small/medium — точнее. Модель скачивается один раз.
VOICE_MODEL=base
VOICE_LANGUAGE=ru
VOICE_ENABLED=true
VOICE_COMPUTE_TYPE=int8
MODELS_DIR=./data/models

# --- Отдача веб-клиента ---
# Путь к собранному Flutter Web. Пусто = отключить раздачу статики.
WEB_ROOT=./data/web

# --- Бэкапы ---
BACKUP_DIR=./data/backups
